<launch>
  <arg
    name="model" />
  <arg
    name="gui"
    default="True" />
  <param
    name="robot_description"
    textfile="$(find X20)/urdf/X20_rsm.urdf" />

  <node
    name="joint_state_publisher_gui"
    pkg="joint_state_publisher_gui"
    type="joint_state_publisher_gui" >
  <param
    name="use_gui"
    value="$(arg gui)" />
</node>
  <node
    name="robot_state_publisher"
    pkg="robot_state_publisher"
    type="robot_state_publisher" />
  <node
    name="rviz"
    pkg="rviz"
    type="rviz"
    args="-d $(find X20)/urdf.rviz" />
    <!-- <node name="odom_to_map"  pkg="tf" type="static_transform_publisher" output="screen"  args="10 2 0 1.57 0.3 0.2  /map /base 200" /> -->
</launch>
