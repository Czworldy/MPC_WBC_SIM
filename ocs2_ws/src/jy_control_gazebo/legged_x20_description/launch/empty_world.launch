<launch>
    <arg name="robot_type" default="x20" doc="x20"/>
    <!-- Load the URDF into the ROS Parameter Server -->
    <param name="legged_robot_description" command="$(find xacro)/xacro $(find legged_x20_description)/urdf/gazebo_x20/X20_gazebo.xacro"/>
    <node name="generate_urdf" pkg="legged_common" type="generate_urdf.sh" output="screen"
          args="$(find legged_x20_description)/urdf/gazebo_x20/X20_gazebo.xacro $(arg robot_type)"/>

    <param name="robot_description" command="$(find xacro)/xacro $(find legged_x20_description)/urdf/gazebo_x20/X20_gazebo.xacro"/>
    <rosparam file="$(find legged_gazebo)/config/default.yaml" command="load"/>
    <include file="$(find gazebo_ros)/launch/empty_world.launch">
        <!-- <arg name="world_name" value="$(find legged_gazebo)/worlds/stair_pipe4_swing.world"/> -->
        <!-- niuqu test  -->
        <arg name="world_name" value="$(find legged_gazebo)/worlds/mhz_22_shousuo.world"/> 
        <!-- <arg name="world_name" value="$(find legged_gazebo)/worlds/mhz_6.world"/> -->
        <!-- <arg name="pause" value="true"/> -->
    </include>
    <!-- push robot_description to factory and spawn robot in gazebo -->
    <node name="spawn_urdf" pkg="gazebo_ros" type="spawn_model" clear_params="true"
          args="-z 1.2 -param legged_robot_description -urdf -model X20" output="screen"/>
    <!-- <node name="urdf_spawner" pkg="gazebo_ros" type="spawn_model" respawn="false" output="screen" args="-urdf -model X20 -param legged_robot_description
        -z 0.6"/> -->

</launch>
