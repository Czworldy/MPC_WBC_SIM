  <xacro:property name="foot_mass" value="0.001"/>
  <xacro:property name="foot_radius" value="0.036"/>
  <xacro:macro name="setup_foot" params="link_name">
    <link name="${link_name}">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <sphere radius="${foot_radius-0.01}"/>
            </geometry>
        </visual>
        <collision name="${link_name}_collision">
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <sphere radius="${foot_radius}"/>
            </geometry>
              <surface>
                <bounce>
                    <restitution_coefficient>0</restitution_coefficient>
                    <threshold>1e+06</threshold>
                </bounce>
                <friction>
                    <ode>
                        <mu>0.2</mu>
                        <mu2>0.2</mu2>
                    </ode>
                    <bullet>
                        <rolling_friction>0.3</rolling_friction>
                        <friction2>50</friction2>
                    </bullet>
                </friction>
                <contact>
                    <ode>
                        <kp>30000.0</kp>
                        <kd>1000.0</kd>
                    </ode>
                    <bullet>
                        <kp>30000.0</kp>
                        <kd>1000.0</kd>
                        <split_impulse>1</split_impulse>
                        <split_impulse_penetration_threshold>-0.01</split_impulse_penetration_threshold>
                    </bullet>
                </contact>
            </surface>
         </collision>
        <inertial>
            <mass value="${foot_mass}"/>
            <inertia
                    ixx="${(2*foot_mass)/5.0*(foot_radius*foot_radius)}" ixy="0.0" ixz="0.0"
                    iyy="${(2*foot_mass)/5.0*(foot_radius*foot_radius)}" iyz="0.0"
                    izz="${(2*foot_mass)/5.0*(foot_radius*foot_radius)}"/>
        </inertial>
    </link>
    <!-- <gazebo reference="$j{link_name}">
      <disableFixedJointLumping>true</disableFixedJointLumping>
    </gazebo>
    <gazebo reference="${link_name}">
        <mu1>0.8</mu1>
        <mu2>0.8</mu2>
        <self_collide>1</self_collide>
        <material>Gazebo/DarkGrey</material>
        <kp value="1000000.0"/>
        <kd value="100.0"/>
    </gazebo> -->
  </xacro:macro>
  
  <xacro:setup_foot link_name="toe0"/>
  <xacro:setup_foot link_name="toe1"/>
  <xacro:setup_foot link_name="toe2"/>
  <xacro:setup_foot link_name="toe3"/>

  <!-- Link setup-->
  <xacro:macro name="link_setup_block" params="link_name">
    <gazebo reference="${link_name}">
      <mu1>0.6</mu1>
      <mu2>0.6</mu2>
      <self_collide>1</self_collide>
      <!-- <material>Gazebo/DarkGrey</material> -->
      <kp value="1000000.0"/>
      <kd value="100.0"/>
    </gazebo>
  </xacro:macro>
  <xacro:link_setup_block link_name="lower0"/>  
  <xacro:link_setup_block link_name="lower1"/>
  <xacro:link_setup_block link_name="lower2"/>
  <xacro:link_setup_block link_name="lower3"/>
  
  <xacro:macro name="link_setup_block_hip" params="link_name">
    <gazebo reference="${link_name}">
      <mu1>0.2</mu1>
      <mu2>0.2</mu2>
      <!-- <material>Gazebo/DarkGrey</material> -->
    </gazebo>
  </xacro:macro>
  <xacro:macro name="link_setup_block_thight" params="link_name">
    <gazebo reference="${link_name}">
      <mu1>0.2</mu1>
      <mu2>0.2</mu2>
      <self_collide>0</self_collide>
      <!-- <material>Gazebo/DarkGrey</material> -->
      <kp value="1000000.0"/>
      <kd value="100.0"/>
    </gazebo>
  </xacro:macro>
  <xacro:link_setup_block_hip link_name="hip0"/>
  <xacro:link_setup_block_thight link_name="upper0"/>
  <xacro:link_setup_block_hip link_name="hip2"/>
  <xacro:link_setup_block_thight link_name="upper2"/>
  <xacro:link_setup_block_hip link_name="hip1"/>
  <xacro:link_setup_block_thight link_name="upper1"/>
  <xacro:link_setup_block_hip link_name="hip3"/>
  <xacro:link_setup_block_thight link_name="upper3"/>

  <xacro:include filename="$(find x20_description)/urdf/transmission.xacro" />


</robot>