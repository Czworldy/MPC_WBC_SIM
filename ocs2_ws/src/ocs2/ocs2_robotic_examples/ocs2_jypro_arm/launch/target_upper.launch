<?xml version = "1.0" ?>

<launch>
    <arg name="robot_name"         default="legged_robot_with_arm"/>
    <arg name="config_name"        default="mpc"/>
    <arg name="target_command"     default="$(find ocs2_jypro_arm)/config/command/targetTrajectories.info"/>
    <arg name="gait_command"       default="$(find ocs2_jypro_arm)/config/command/gait.info"/>
    <arg name="rviz"               default="true" />
    <arg name="multiplot"          default="false"/>
    <arg name="description_name"   default="legged_robot_with_arm_description"/>
    <arg name="description_file"   default="$(find X20)/urdf/X20_ARM_ocs2.urdf"/>
    

    <node pkg="ocs2_jypro_arm" type="legged_robot_with_arm_target_upper" name="legged_robot_with_arm_target_upper"
          output="screen" args="$(arg robot_name) $(arg target_command)"/>

          
</launch>
