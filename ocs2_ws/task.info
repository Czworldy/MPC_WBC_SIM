centroidalModelType             1     // 0: FullCentroidalDynamics, 1: Single Rigid Body Dynamics
useFeetPlacementConstraint      true
useIKresult                     true
useEndEffectorTrackingCost      true

legged_robot_interface
{
  verbose                               false  // show the loaded parameters
  useAnalyticalGradientsDynamics        false
  useAnalyticalGradientsConstraints     false
}

model_settings
{
  positionErrorGain             0.0
  phaseTransitionStanceTime     0.4

  verboseCppAd                  true
  recompileLibrariesCppAd       false
  modelFolderCppAd              /home/ysc/cppad
}

swing_trajectory_config
{
  liftOffVelocity               0.2
  touchDownVelocity            -0.4     ;-0.2
  swingHeight                   0.21
  touchdownAfterHorizon         0.2
  swingTimeScale                0.15
}

initialModeSchedule
{
  modeSequence
  {
    [0]  STANCE
    [1]  STANCE
  }
  eventTimes
  {
    [0]  0.5
  }
}

defaultModeSequenceTemplate
{
  modeSequence
  {
    [0]  STANCE
  }
  switchingTimes
  {
    [0]  0.0
    [1]  1.0
  }
}

; multiple_shooting settings
multiple_shooting
{
  nThreads                              3
  dt                                    0.015
  sqpIteration                          2
  deltaTol                              1e-4
  g_max                                 1e-2
  g_min                                 1e-6
  inequalityConstraintMu                0.1
  inequalityConstraintDelta             5.0
  projectStateInputEqualityConstraints  true
  printSolverStatistics                 true
  printSolverStatus                     false
  printLinesearch                       false
  useFeedbackPolicy                     true
  integratorType                        RK2
  threadPriority                        10
}

; DDP settings
ddp
{
  algorithm                       SLQ

  nThreads                        4
  threadPriority                  20

  maxNumIterations                10
  minRelCost                      1e-1
  constraintTolerance             5e-3

  displayInfo                     false
  displayShortSummary             false
  checkNumericalStability         false
  debugPrintRollout               false
  debugCaching                    false

  AbsTolODE                       1e-5
  RelTolODE                       1e-3
  maxNumStepsPerSecond            10000
  timeStep                        1e-2
  backwardPassIntegratorType      ODE45

  constraintPenaltyInitialValue   20.0
  constraintPenaltyIncreaseRate   2.0
  inequalityConstraintMu          0.1
  inequalityConstraintDelta       5.0

  preComputeRiccatiTerms          true
  useNominalTimeForBackwardPass   true

  useFeedbackPolicy               false

  strategy                        LINE_SEARCH
  lineSearch
  {
    minStepLength                 1e-4
    maxStepLength                 1.0
    hessianCorrectionStrategy     DIAGONAL_SHIFT
    hessianCorrectionMultiple     1e-5
  }
}

; Rollout settings
rollout
{
  AbsTolODE                       1e-5
  RelTolODE                       1e-3
  timeStep                        1e-3
  maxNumStepsPerSecond            10000
  checkNumericalStability         false
}

mpc
{
  timeHorizon                     1.0
  numPartitions                   3

  runtimeMaxNumIterations         5
  initMaxNumIterations            10

  runtimeMinStepLength            1e-2
  runtimeMaxStepLength            1.0
  initMinStepLength               1e-2
  initMaxStepLength               1.0

  debugPrint                      false
  coldStart                       false

  useParallelRiccatiSolver        true ; use disjoint riccati solver in multi-thread case

  solutionTimeWindow              -1  ; [s]

  mpcDesiredFrequency             -1  ; [Hz]
  mrtDesiredFrequency             500 ; [Hz]
}

initialState
{
   ;; Normalized Centroidal Momentum: [linear, angular] ;;
   (0,0)  0.0     ; vcom_x
   (1,0)  0.0     ; vcom_y
   (2,0)  0.0     ; vcom_z
   (3,0)  0.0     ; L_x / robotMass
   (4,0)  0.0     ; L_y / robotMass
   (5,0)  0.0     ; L_z / robotMass


   ;; Base Pose: [position, orientation] ;;
   (6,0)  0.00  ; p_base_x
   (7,0)  0.00    ; p_base_y
   (8,0)  0.00    ; p_base_z
   (9,0)  0.00    ; theta_base_z
   (10,0) 0.00   ; theta_base_y
   (11,0) 0.00  ; theta_base_x

   ;; Leg Joint Positions: [LF, LH, RF, RH] ;;
   (12,0)  -0.00     ; LF_HAA
   (13,0)  -0.95  ; LF_HFE
   (14,0)  1.78   ; LF_KFE
   (15,0)  -0.00     ; LH_HAA
   (16,0)  -0.95  ; LH_HFE
   (17,0)  1.78   ; LH_KFE
   (18,0)  -0.00     ; RF_HAA
   (19,0)  -0.95  ; RF_HFE
   (20,0)  1.78   ; RF_KFE
   (21,0)  -0.00     ; RH_HAA
   (22,0)  -0.95  ; RH_HFE
   (23,0)  1.78   ; RH_KFE
}

; standard state weight matrix
Q
{
  scaling 1e+0

  ;; Normalized Centroidal Momentum: [linear, angular] ;;
  (0,0)   30.0     ; vcom_x0
  (1,1)   30.0     ; vcom_y
  (2,2)   100.0     ; vcom_z
  (3,3)   10.0      ; L_x / robotMass
  (4,4)   30.0     ; L_y / robotMass
  (5,5)   30.0     ; L_z / robotMass

  ;; Base Pose: [position, orientation] ;;'
  (6,6)   500.0    ; p_base_x                         reduce to 250.0 for foot placement constraints.
  (7,7)   500.0    ; p_base_y                         reduce to 250.0 for foot placement constraints.
  (8,8)   300.0    ; p_base_z                         reduce to 250.0 for foot placement constraints.
  (9,9)   100.0    ; theta_base_z
  (10,10) 500.0    ; theta_base_y
  (11,11) 500.0    ; theta_base_x

  ;; Leg Joint Positions: [LF, LH, RF, RH] ;; 不能太低
  (12,12) 10.0     ; LF_HAA
  (13,13) 10.0     ; LF_HFE
  (14,14) 10.0     ; LF_KFE
  (15,15) 10.0     ; LH_HAA
  (16,16) 10.0     ; LH_HFE
  (17,17) 10.0     ; LH_KFE
  (18,18) 10.0     ; RF_HAA
  (19,19) 10.0     ; RF_HFE
  (20,20) 10.0     ; RF_KFE
  (21,21) 10.0     ; RH_HAA
  (22,22) 10.0     ; RH_HFE
  (23,23) 10.0     ; RH_KFE
}

; control weight matrix
R
{
  scaling 1e-3

  ;; Feet Contact Forces: [LF, RF, LH, RH] ;;
  (0,0)   2.0       ; left_front_force
  (1,1)   2.0       ; left_front_force
  (2,2)   2.0       ; left_front_force
  (3,3)   2.0       ; right_front_force
  (4,4)   2.0       ; right_front_force
  (5,5)   2.0       ; right_front_force
  (6,6)   2.0       ; left_hind_force
  (7,7)   2.0       ; left_hind_force
  (8,8)   2.0       ; left_hind_force
  (9,9)   2.0       ; right_hind_force
  (10,10) 2.0       ; right_hind_force
  (11,11) 2.0       ; right_hind_force

  ;; Leg Joint Velocities: [LF, LH, RF, RH] ;;
  (12,12) 3000.0    ; LF_HAA
  (13,13) 3000.0    ; LF_HFE
  (14,14) 3000.0    ; LF_KFE
  (15,15) 3000.0    ; LH_HAA
  (16,16) 3000.0    ; LH_HFE
  (17,17) 3000.0    ; LH_KFE
  (18,18) 3000.0    ; RF_HAA
  (19,19) 3000.0    ; RF_HFE
  (20,20) 3000.0    ; RF_KFE
  (21,21) 3000.0    ; RH_HAA
  (22,22) 3000.0    ; RH_HFE
  (23,23) 3000.0    ; RH_KFE
}

frictionConeSoftConstraint
{
  frictionCoefficient    0.6

  ; relaxed log barrier parameters
  mu                     0.1
  delta                  5.0
}

footPlancementSoftConstraint
{
  ; relaxed log barrier parameters
  mu                     0.01
  delta                  0.3
}

