{
  scaling 1e+0

  (0,0)   30.0     ; vcom_x0
  (1,1)   30.0     ; vcom_y
  (2,2)   30.0     ; vcom_z
}

Ree
{
  scaling 1e+0

  (0,0)   5.0     ; vcom_x0
  (1,1)   5.0     ; vcom_y
  (2,2)   5.0     ; vcom_z
}
